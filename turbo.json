{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": [
    "DEVHUB_PORT",
    "DEVHUB_WEB_PORT",
    "DEVHUB_HOME",
    "LOG_LEVEL",
    "NODE_ENV",
    "DEVHUB_TOKENS_FROM_ENV",
    "DEVHUB_KEYCHAIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
