{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": [
    "DEVHUB_PORT",
    "DEVHUB_WEB_PORT",
    "DEVHUB_HOME",
    "LOG_LEVEL",
    "NODE_ENV",
    "DEVHUB_TOKENS_FROM_ENV",
    "DEVHUB_KEYCHAIN",
    "DEVHUB_CLAUDE_CODE",
    "DEVHUB_SANDBOX"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "@devhub/server#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "USER",
        "LOGNAME",
        "SHELL",
        "TMPDIR",
        "LANG",
        "LC_*",
        "CLAUDE_*",
        "ANTHROPIC_*",
        "AWS_*",
        "GOOGLE_*",
        "CLOUD_ML_REGION",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "https_proxy",
        "http_proxy",
        "no_proxy",
        "NODE_EXTRA_CA_CERTS",
        "SSL_CERT_FILE"
      ]
    }
  }
}
