{
  "name": "@devhub/server",
  "version": "0.0.0",
  "private": true,
  "description": "The Node host for @devhub/core: reads config, writes the session token, serves the built web app and listens on 127.0.0.1.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.mjs --serve-web",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@devhub/contracts": "workspace:*",
    "@devhub/core": "workspace:*",
    "@fastify/static": "^10.1.6",
    "@napi-rs/keyring": "^2.1.1",
    "fastify": "^5.12.7",
    "jira.js": "^6.3.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
