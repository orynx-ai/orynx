node_modules/
dist/
storybook-static/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
.turbo/
.vite/
.eslintcache

# Local runtime data (tokens, cache, sessions, worktrees) never belongs in git.
.devhub/
# The inbox's cache holds work titles and the Jira email (spec 007), wherever DEVHUB_HOME points.
cache.db
cache.db-*
.env
.env.*
!.env.example

# Local review stamp: proof that /review passed for this exact change.
.claude/review-stamp.json
.claude/settings.local.json

.DS_Store
*.log

# Vitest blob reports, one per package in CI, merged by `vitest --merge-reports`.
.vitest/

# The desktop app's staged hub and its installers (spec 027).
apps/desktop/.stage/
apps/desktop/release/

# Skills added with `npx skills add` are pinned in skills-lock.json, not stored here:
# `npx skills experimental_install` restores them (brag alone is 16 MB of audio).
.claude/skills/brag/
# Scratch output of the /brag skill: renders, stems, screenshots and its local voice model (hundreds of MB).
brag-output/
