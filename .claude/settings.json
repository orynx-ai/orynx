{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm gate:*)",
      "Bash(pnpm gates:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm storybook)",
      "Bash(pnpm agent-rules:*)",
      "Bash(pnpm review:stamp:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git merge-base:*)",
      "Bash(node scripts/:*)",
      "Bash(node --test:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(pnpm add:*)", "Bash(pnpm remove:*)", "Bash(gh pr create:*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(~/.devhub/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/pre-tool-guard.ts\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/post-edit-format.ts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/stop-review.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
