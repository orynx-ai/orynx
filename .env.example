# Every setting the local server reads. Copy to .env only if you want to override a default.
# check:env-policy fails when code reads a setting that is not listed here.

# Port the local server listens on (always 127.0.0.1).
DEVHUB_PORT=4317
# Port the Vite dev server uses for the web app during `pnpm dev`.
DEVHUB_WEB_PORT=4318
# Folder for the cache, session logs and worktrees. Defaults to ~/.devhub.
DEVHUB_HOME=
# Where Jira, GitHub and Slack tokens are saved: os (your OS keychain) | memory (forgotten when
# DevHub stops). The e2e run uses memory so it never touches your keychain. Leave it at os.
DEVHUB_KEYCHAIN=os
# The Claude Code program DevHub runs to check your Claude login. Leave it empty to run the one in the
# Claude Agent SDK. DevHub reads it from the shell only, never from this file: a file must not decide
# which program DevHub starts. The e2e run sets it to a fake.
DEVHUB_CLAUDE_CODE=
# Whether Orynx checks that Claude Code's sandbox can run before Claude runs commands in a session:
# required | assume. Every command runs in that sandbox (macOS has it; Linux needs bubblewrap and socat).
# The e2e run sets assume, because its fake Claude Code has no sandbox. Leave it at required.
DEVHUB_SANDBOX=required
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# development | production | test
NODE_ENV=development
# Keep Jira, GitHub and Slack tokens in this file instead of the OS keychain: true | false.
# Turn it on only when your keychain can't be used. This file is plain text: run chmod 600 .env.
DEVHUB_TOKENS_FROM_ENV=false
# Read only when DEVHUB_TOKENS_FROM_ENV=true. A token saved in the keychain wins over these.
DEVHUB_JIRA_API_TOKEN=
DEVHUB_GITHUB_TOKEN=
DEVHUB_SLACK_USER_TOKEN=
