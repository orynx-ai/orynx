#!/bin/sh
# Stands in for Claude Code in the e2e run: playwright.config.ts names it with DEVHUB_CLAUDE_CODE, so
# the run never reads your real Claude login (spec 010, AC-12). DevHub runs it as `auth status --json`.
# It's signed out, unless CLAUDE_CONFIG_DIR holds an answer a spec wrote (config.ts, answerClaudeAs):
# then it prints that answer and exits 0.
answer="${CLAUDE_CONFIG_DIR:-/nonexistent}/fake-auth-status.json"
if [ -f "$answer" ]; then
  cat "$answer"
  exit 0
fi
printf '%s\n' '{ "loggedIn": false, "authMethod": "none", "apiProvider": "firstParty" }'
exit 1
