{
  "name": "devhub",
  "private": true,
  "description": "DevHub: one local workspace for the Jira, GitHub and Slack work that needs you, with Claude building tickets in a worktree you control.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run build --filter=@devhub/server... --filter=@devhub/web && pnpm --filter @devhub/server start",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed origin/main",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "storybook": "pnpm --filter @devhub/ui storybook",
    "gates": "node --disable-warning=ExperimentalWarning scripts/run-gates.ts",
    "gates:test": "node --disable-warning=ExperimentalWarning --test \"scripts/**/*.test.ts\"",
    "gate": "node --disable-warning=ExperimentalWarning scripts/run-gates.ts --only",
    "agent-rules": "node --disable-warning=ExperimentalWarning scripts/sync-agent-rules.ts",
    "review:stamp": "node --disable-warning=ExperimentalWarning scripts/review-stamp.ts",
    "verify": "pnpm gates && pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,yml,yaml,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tanstack/eslint-plugin-query": "^5.104.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
